# Website prelaunch: no search indexing until domain, legal and payments ready.
SITE_PUBLIC_LAUNCH_ENABLED=false

# Supabase Auth + server-only quota functions (never expose service role client-side).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
USAGE_DB_QUOTAS_ENABLED=false
UNLIMITED_QUOTA_ENABLED=false

# PayPal: do not mix sandbox credentials with the LIVE checkout guard.
# Enter LIVE credentials only in secured Vercel production variables.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
PAYPAL_PLAN_ID_STARTER=
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_PREMIUM=
PAYPAL_PLAN_ID_UNLIMITED=
PAYPAL_PLAN_ID_STARTER_YEARLY=
PAYPAL_PLAN_ID_PRO_YEARLY=
PAYPAL_PLAN_ID_PREMIUM_YEARLY=
PAYPAL_PLAN_ID_UNLIMITED_YEARLY=

# Never enable until authorized end-to-end merchant/payment tests are successful.
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_YEARLY_CHECKOUT_ENABLED=false
PAYPAL_UNLIMITED_CHECKOUT_ENABLED=false
